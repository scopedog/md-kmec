# kcsan.config — KCSAN (Kernel Concurrency SANitizer) config fragment for
# md-kmec race hunting.  Merge into the md-kmec kernel .config with:
#
#     scripts/kconfig/merge_config.sh -m .config tools/kcsan.config
#     make olddefconfig
#
# WHY: KCSAN is a *data-race* detector (sampling-based, compiler-instrumented,
# -fsanitize=thread).  It catches the atomicity-invariant bugs that lockdep
# structurally cannot see — exactly the class flagged for the raid5_unplug
# group-lock work ("lockdep CANNOT catch this") and latent in every lock-elided
# md-kmec fast path: skip_copy page aliasing, stripe-head recycling, the live
# group_thread_cnt worker_groups swap, the declustered redirect map, and the
# healed_blocks / stat_w_preread atomics.
#
# ┌─ MUTUALLY EXCLUSIVE WITH KASAN ─────────────────────────────────────────┐
# │ KCSAN and KASAN both own the compiler's sanitizer slot; you cannot build │
# │ one kernel with both.  This is a SEPARATE kernel build from your KASAN   │
# │ gate.  Keep running the KASAN kernel for use-after-free/OOB; add this    │
# │ KCSAN kernel for data races.  Toolchain: GCC >= 11 or Clang >= 14.       │
# └─────────────────────────────────────────────────────────────────────────┘

# --- KCSAN core ---
CONFIG_KCSAN=y
CONFIG_KCSAN_EARLY_ENABLE=y          # armed at boot; no need to echo on via debugfs
CONFIG_KCSAN_VERBOSE=y               # include the *other* thread's stack in each report
CONFIG_KCSAN_INTERRUPT_WATCHER=y     # detect task<->IRQ races — critical: raid5 endio
                                     #   (raid5_end_write_request, ops_complete_*) runs in
                                     #   softirq and races the submit path
# Report a race even when the observed value did not change — more aggressive,
# surfaces "benign-looking" torn accesses that are real bugs on the alias path.
# CONFIG_KCSAN_REPORT_VALUE_CHANGE_ONLY is left =y (default) to start; flip to
# =n for a second, noisier sweep once the first pass is clean.
CONFIG_KCSAN_REPORT_VALUE_CHANGE_ONLY=y

# Strict mode: assume NO access is "atomic by fiat" unless marked data_race()/
# READ_ONCE/WRITE_ONCE.  This is what you want for a real audit — it forces the
# fast paths to justify every unmarked shared access.  Start with STRICT off for
# a low-noise first run, then turn it on:
#   CONFIG_KCSAN_STRICT=y   (enable for the second, thorough sweep)
CONFIG_KCSAN_STRICT=n

# Sampling knobs are BOOT PARAMETERS, not Kconfig (documented in the harness):
#   kcsan.skip_watch=250   # watch 1-in-N memory ops (default 4000; lower = more
#                          #   sensitive, slower — 250 is a good md-focused value)
#   kcsan.udelay_task=500 kcsan.udelay_interrupt=20   # widen the race window
# The build-time default below just sets a sane starting skip; boot param wins.
CONFIG_KCSAN_SKIP_WATCH=250

# --- supporting debug (all compatible with KCSAN; keep lockdep + list debug) ---
CONFIG_DEBUG_KERNEL=y
CONFIG_PROVE_LOCKING=y                # lockdep still valuable alongside KCSAN
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y                   # the BUG_ON that guards stripe list invariants
CONFIG_DEBUG_PREEMPT=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y   # symbolized stacks in the splats

# --- do NOT set (incompatible or counterproductive) ---
# CONFIG_KASAN            -> mutually exclusive with KCSAN (see banner)
# CONFIG_KCSAN_STRICT=y   -> turn on only for the second sweep (noise)
